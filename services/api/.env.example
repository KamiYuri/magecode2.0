APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# D-88: JSON to stdout, which is all the Docker Loki driver can collect.
LOG_CHANNEL=stdout
LOG_SERVICE=api
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PgBouncer in transaction pooling mode (D-89). Point at 5432 to bypass
# the pooler when running migrations that need session-level features.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=magecode
DB_USERNAME=magecode
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=database

# Job messages to the Go workers (App\Messaging), not Laravel's queue.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=magecode
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=magecode

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── MinIO (D-31) ──
# Compose injects these into the api container with MINIO_ENDPOINT=http://minio:9000.
# On the host, MinIO's S3 API is published on loopback only.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=magecode
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL=21600

# MinIO-backed tests skip unless these are set; `make test-api` fills them in
# from the repo-root .env when it has been exported (see the Makefile).
MINIO_TEST_ENDPOINT=
MINIO_TEST_ACCESS_KEY=
MINIO_TEST_SECRET_KEY=
MINIO_TEST_BUCKET=

VITE_APP_NAME="${APP_NAME}"
