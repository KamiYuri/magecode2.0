.env
.env.*
!.env.example
.git
.phpunit.cache
.phpunit.result.cache
node_modules
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
# Storage::fake() writes here, and the suite runs as root inside the test
# image — so the directory ends up unreadable to the host user and breaks the
# build context. It is scratch either way and has no business in an image.
storage/framework/testing/*
tests/coverage
vendor
