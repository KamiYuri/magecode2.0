{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magecode:queue:code-executor:job:1.0",
  "title": "CES Job Message",
  "description": "Triggers code execution for a single submission. CES has direct DB access — reads test cases, programming language, and file path from DB. Only submission_id needed.",
  "type": "object",
  "required": ["submission_id", "trace_id", "timestamp", "version"],
  "additionalProperties": false,
  "properties": {
    "submission_id": {
      "type": "integer",
      "minimum": 1,
      "description": "PK of submissions table"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "Cross-service tracing ID, generated by api"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC publish time"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    }
  }
}
