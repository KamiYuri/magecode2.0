# ─────────────────────────────────────────────
# MageCode 2.0 Environment Configuration
# Copy to .env and fill in values
# ─────────────────────────────────────────────

COMPOSE_PROJECT_NAME=magecode
APP_ENV=local
APP_DOMAIN=localhost
APP_URL=http://${APP_DOMAIN}

# ── PostgreSQL ──
POSTGRES_DB=magecode
POSTGRES_USER=magecode
POSTGRES_PASSWORD=                   # REQUIRED
POSTGRES_PORT=5432

# ── PgBouncer (D-89) ──
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=30
PGBOUNCER_MAX_CLIENT_CONN=150
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=magecode
RABBITMQ_DEFAULT_PASS=               # REQUIRED
RABBITMQ_DEFAULT_VHOST=magecode
RABBITMQ_MANAGEMENT_PORT=15672

# ── MinIO (D-31) ──
MINIO_ROOT_USER=magecode
MINIO_ROOT_PASSWORD=                 # REQUIRED: min 8 chars
MINIO_BUCKET=magecode
MINIO_CONSOLE_PORT=9001
MINIO_PRESIGNED_URL_TTL=21600        # 6 hours (D-85)

# ── Laravel API ──
APP_KEY=                             # REQUIRED: php artisan key:generate
APP_DEBUG=true
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=${PGBOUNCER_PORT}
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ── Laravel Reverb ──
REVERB_APP_ID=magecode
REVERB_APP_KEY=                      # REQUIRED
REVERB_APP_SECRET=                   # REQUIRED

# ── Judge0 ──
JUDGE0_DB_PASSWORD=                  # REQUIRED
JUDGE0_REDIS_PASSWORD=               # REQUIRED
JUDGE0_AUTH_TOKEN=                   # REQUIRED
CES_JUDGE0_URL=http://judge0-server:2358
CES_JUDGE0_AUTH_TOKEN=${JUDGE0_AUTH_TOKEN}
CES_WORKER_COUNT=5

# ── Analysis workers (SIM / AID / VUL) ────────────────────────────────────────
# Prefetch follows D-76: SIM 1 (a job is a whole language group), AID/VUL 3.
SIM_PREFETCH=1
SIM_DOLOS_TIMEOUT=300s          # wall clock for one Dolos comparison
SIM_MAX_REGIONS_PER_PAIR=100    # bounds one pair's highlight list (TEXT column)

AID_PREFETCH=3
# The -mlm release, deliberately: plain codebert-base carries no trained head
# of any kind and its probabilities are noise (decisions-v3 §7, 2026-08-19).
# A fine-tuned *ForSequenceClassification checkpoint here switches the scorer.
AID_MODEL_NAME=microsoft/codebert-base-mlm
AID_BATCH_SIZE=8
AID_DEVICE=cpu
# Where the 50/50 line falls on the predictability scorer, and how fast the
# curve leaves it. Not fitted to a labelled corpus — see the decision above.
AID_CALIBRATION_MEAN=1.40
AID_CALIBRATION_SCALE=0.15

VUL_PREFETCH=3
VUL_CODEQL_TIMEOUT=600s         # database build + analyze, per submission
VUL_CODEQL_THREADS=2

# ── Observability ──
GRAFANA_ADMIN_PASSWORD=              # REQUIRED
